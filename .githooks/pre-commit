#!/usr/bin/env bash
# Pre-commit hook: block commits containing hardcoded secrets
# Scans staged file diffs for AWS account IDs, email addresses, keys, passwords
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FOUND=0

# Files to skip
SKIP_EXT='\.(png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|map|lock)$'
SKIP_FILES='package-lock\.json|yarn\.lock'

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -vE "$SKIP_EXT" | grep -vE "$SKIP_FILES" || true)

[ -z "$STAGED" ] && exit 0

# Get only added lines from staged diff for a file
staged_additions() {
  git diff --cached -- "$1" | grep '^+' | grep -v '^+++' || true
}

flag() {
  local label="$1" file="$2" pattern="$3"
  local match
  match=$(staged_additions "$file" | grep -oE "$pattern" | grep -v 'example\.com' | head -1 || true)
  if [ -n "$match" ]; then
    echo -e "${RED}BLOCKED${NC} ${YELLOW}${label}${NC} in ${file}: '${match}'"
    FOUND=1
  fi
}

for FILE in $STAGED; do
  # AWS Account ID: exactly 12 consecutive digits (not part of a longer number)
  # Using perl for word-boundary support on macOS
  match=$(staged_additions "$FILE" | perl -nle 'print $1 if /(?<!\d)(\d{12})(?!\d)/' | head -1 || true)
  if [ -n "$match" ]; then
    echo -e "${RED}BLOCKED${NC} ${YELLOW}AWS Account ID${NC} in ${FILE}: '${match}'"
    FOUND=1
  fi

  # Real email addresses (skip *@example.com placeholders)
  match=$(staged_additions "$FILE" | grep -oE '[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}' | grep -v '@example\.com' | head -1 || true)
  if [ -n "$match" ]; then
    echo -e "${RED}BLOCKED${NC} ${YELLOW}Email address${NC} in ${FILE}: '${match}'"
    FOUND=1
  fi

  # AWS Access Key IDs
  flag "AWS Access Key ID"  "$FILE" '(AKIA|ASIA|AROA|AIDA)[A-Z0-9]{16}'

  # AWS Secret Access Keys (40-char base64)
  flag "AWS Secret Key"     "$FILE" '(aws_secret_access_key|secret_access_key)[[:space:]]*[=:][[:space:]]*[A-Za-z0-9/+]{40}'

  # Private key headers (pattern split to avoid self-match)
  PK_MARKER="BEGIN"" PRIVATE KEY"
  match=$(staged_additions "$FILE" | grep -i "$PK_MARKER" | head -1 || true)
  if [ -n "$match" ]; then
    echo -e "${RED}BLOCKED${NC} ${YELLOW}Private key${NC} in ${FILE}"
    FOUND=1
  fi
done

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo -e "${RED}Commit blocked.${NC} Remove sensitive values before committing."
  echo "  • Use placeholders: 'your-email@example.com', 'YOUR_ACCOUNT_ID'"
  echo "  • Put real values in .env (gitignored), not source files"
  echo "  • Emergency bypass: git commit --no-verify  (use with caution)"
  exit 1
fi

exit 0
